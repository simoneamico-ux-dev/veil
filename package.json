{
  "name": "veil",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run verify:vendor && npm run verify:runtime && npm run verify:cache && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm test && playwright test",
    "verify:cache": "node scripts/verify-cache-revision.mjs",
    "verify:runtime": "node scripts/check-runtime-origins.mjs",
    "verify:vendor": "node scripts/verify-vendor.mjs",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "happy-dom": "^20.12.0",
    "pdf-lib": "^1.17.1",
    "vitest": "^3.2.7"
  }
}
